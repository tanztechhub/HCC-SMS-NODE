# Local MongoDB must be a replica set for transactional workflows.
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HCC_SMS_MONGODB_URI=mongodb://127.0.0.1:27017/hcc
HCC_SMS_DB_NAME=hcc
HCC_SMS_JWT_SECRET=replace-with-a-long-random-secret
ADMIN_DASHBOARD_URL=http://localhost:5173/admin
HCC_SMS_CLOUDINARY_CLOUD_NAME=
HCC_SMS_CLOUDINARY_API_KEY=
HCC_SMS_CLOUDINARY_API_SECRET=
HCC_SMS_ADMIN_CC_EMAIL=
HCC_SMS_ADMIN_EMAIL=
HCC_SMS_EMAIL=
HCC_SMS_EMAIL_PASSWORD=
